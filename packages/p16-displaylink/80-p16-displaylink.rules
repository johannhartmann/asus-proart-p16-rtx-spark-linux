# DisplayLinkManager discovers USB graphics devices through its by-id directory.
ACTION=="add|change", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="17e9", ENV{ID_USB_INTERFACES}=="*:ff??03:*|*:13??00:*", \
  SYMLINK+="displaylink/by-id/$env{ID_BUS}-$env{BUSNUM}-$env{DEVNUM}-$env{ID_SERIAL}", TAG+="systemd", ENV{SYSTEMD_WANTS}+="displaylink-driver.service"
