  install -Dm644 "$srcdir/p16-platform.modules" "$pkgdir/usr/lib/modules-load.d/p16-platform.conf"
  install -Dm644 "$srcdir/p16-charge-limit.tmpfiles" "$pkgdir/usr/lib/tmpfiles.d/p16-charge-limit.conf"
