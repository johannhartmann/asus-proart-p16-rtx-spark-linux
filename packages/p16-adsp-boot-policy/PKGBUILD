pkgname=p16-adsp-boot-policy
pkgver=0.1.0
pkgrel=1
pkgdesc='P16 normal-boot command line for the in-kernel N1X audio DSP'
arch=('aarch64')
license=('MIT')
depends=('limine-mkinitcpio-hook' 'p16-platform-policy>=1.3.2')
source=('zz-p16-dsp.conf' 'MIT.txt')
sha256sums=('81e1c9a9bb87cbe90d330b3b1ae45355c41f3174f642a55de8d635335f6122f0'
            '213e4f92de2bfb95c95fc90aa94a5378e92a7c3bdf1d2b22768da3fa9068b3b3')
backup=('etc/limine-entry-tool.d/zz-p16-dsp.conf')

package() {
  install -Dm644 "$srcdir/zz-p16-dsp.conf" \
    "$pkgdir/etc/limine-entry-tool.d/zz-p16-dsp.conf"
  install -Dm644 "$srcdir/MIT.txt" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
