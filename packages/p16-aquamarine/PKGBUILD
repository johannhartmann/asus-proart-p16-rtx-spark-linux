# Contributor: Aaron Blasko <blaskoazzolaaaron [at] gmail.com>

# Based on Omarchy aquamarine 0.16.0-1.2 at omacom/omarchy-pkgs
# 3a37c44de0c374b69cec311844e38c5e73f6c400.
pkgname=aquamarine
pkgver=0.16.0
pkgrel=1.21
pkgdesc='a very light linux rendering backend library'
arch=(aarch64)
url="https://github.com/hyprwm/$pkgname"
license=(BSD-3-Clause)
depends=(libgcc
         libstdc++
         glibc # libc.so libm.so
         hyprutils libhyprutils.so
         libdisplay-info libdisplay-info.so
         libdrm # libdrm.so
         libglvnd libEGL.so
         libinput # libinput.so
         mesa # libgbm.so
         opengl-driver
         pixman
         seatd libseat.so
         systemd-libs libudev.so
         wayland libwayland-client.so
         wayland-protocols)
makedepends=(cmake
             hyprwayland-scanner)
provides=("lib$pkgname.so")
_archive="$pkgname-$pkgver"
_omarchy=https://raw.githubusercontent.com/omacom/omarchy-pkgs/3a37c44de0c374b69cec311844e38c5e73f6c400/pkgbuilds/aquamarine
source=("$url/archive/v$pkgver/$_archive.tar.gz"
        "$_omarchy/0001-drm-re-read-possible-CRTCs-when-rescanning-connectors.patch"
        "$_omarchy/0004-drm-reconnect-an-output-whose-connector-gained-modes.patch"
        "$_omarchy/aq-ctm-none-is-identity.patch"
        "$_omarchy/aq-splash-adopt.patch"
        "$_omarchy/aq-hdr-none-stays-none.patch"
        evdi-reject-explicit-nonlinear-import.patch)
sha256sums=('42339c3096c9de6582c0d71bc86b7e63334a3faf6a2b917d385ad093caf66c3c'
            '50e9e38ff915b18074dc9b5dd1d07d7f24e340e99f254476d6abe578eece7864'
            '7fe7620c222d9f323b6a424301b98176f798f41a97945282ec71b361e742511a'
            '9343550f2663def25b8308370626289123f0669caa31f53851c15c33854c5b3b'
            'c1394631534306178768e8472249b266457a058cd3d15a9015619eb2602206be'
            'b5b6aeaa86a0f93b37682cccafb3930b27b80ac5aa67dfc7937e2c8b497ddef8'
            '64dadf9d0be121990682d389208b709fbd9dcbf882fe7952f2095c5da7edc94a')

prepare() {
	cd "$_archive"
	patch -Np1 --fuzz=0 -i ../0001-drm-re-read-possible-CRTCs-when-rescanning-connectors.patch
	patch -Np1 --fuzz=0 -i ../0004-drm-reconnect-an-output-whose-connector-gained-modes.patch
	patch -Np1 --fuzz=0 -i ../aq-ctm-none-is-identity.patch
	patch -Np1 --fuzz=0 -i ../aq-splash-adopt.patch
	patch -Np1 --fuzz=0 -i ../aq-hdr-none-stays-none.patch
	patch -Np1 --fuzz=0 -i ../evdi-reject-explicit-nonlinear-import.patch
}

build() {
	cd "$_archive"
	cmake -B build \
		-D CMAKE_INSTALL_PREFIX=/usr \
		-D CMAKE_BUILD_TYPE=Release
	cmake --build build
}

check() {
	ctest --test-dir "$_archive/build" --output-on-failure
}

package() {
	cd "$_archive"
	DESTDIR="$pkgdir" cmake --install build
	install -Dm0644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE
}
