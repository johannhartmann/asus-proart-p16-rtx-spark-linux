struct trace_primary_prefix { unsigned long dev; unsigned long dsp; };
BEGIN { printf("TRACE_READY\n"); }
kprobe:n1x_adsp:n1x_adsp_primary_trigger /comm=="aplay" || comm=="arecord"/ {
 $p=(struct trace_primary_prefix *)arg0;$d=(struct n1x_adsp *)$p->dsp;
 printf("DSP_TRIGGER start=%d sleeping=%d owner=%d task=%d processing=%d prepared=%d running=%d attempted=%d task_error=%d pcm_error=%d period_error=%d\n",arg1,$d->sleep_prepared,(uint64)$d->primary_owner==arg0,$d->primary_task_active,$d->processing_active,$d->primary_pcm_prepared,$d->primary_running,$d->primary_start_attempted,$d->primary_task_error,$d->primary_pcm_error,$d->primary_period_error);
}
kprobe:snd_soc_mt8901_afe:mt8901_afe_dsp_trigger /comm=="aplay" || comm=="arecord"/ {
 $s=(struct snd_pcm_substream *)arg0;
 printf("FE_TRIGGER cmd=%d state=%d rate=%d channels=%d bits=%d period=%lu periods=%u\n",arg1,$s->runtime->state,$s->runtime->rate,$s->runtime->channels,$s->runtime->sample_bits,$s->runtime->period_size,$s->runtime->periods);
}
kprobe:snd_soc_mt8901_afe:mt8901_afe_sram_endpoint /comm=="aplay" || comm=="arecord"/ {
 $b=(struct mt8901_afe_sram_buffer *)arg0;$r=$b->substream->runtime;$a=(struct mtk_base_afe *)$b->dev->driver_data;
 printf("ENDPOINT state=%d expected=%d/%d/%d/%d/%d actual=%d/%d/%d/%lu/%u memif=%d irq=%d owns_stream=%d occupied=%d sleeping=%d/%d irq_prepared=%d\n",$r->state,$b->endpoint.rate,$b->endpoint.channels,$b->endpoint.sample_bits,$b->endpoint.period_frames,$b->endpoint.periods,$r->rate,$r->channels,$r->sample_bits,$r->period_size,$r->periods,$b->endpoint.memif,$b->endpoint.irq,$a->memif[$b->endpoint.memif].substream==$b->substream,$a->irqs[$b->endpoint.irq].irq_occupyed,$b->sram->sleep_prepared,$b->sram->sleep_saved,$b->irq_prepared);
}
kretprobe:snd_soc_mt8901_afe:mt8901_afe_sram_endpoint /comm=="aplay" || comm=="arecord"/ { printf("ENDPOINT_RETURN=%d\n",(int64)retval); }
kretprobe:n1x_adsp:n1x_adsp_primary_trigger /comm=="aplay" || comm=="arecord"/ { printf("DSP_TRIGGER_RETURN=%d\n",(int64)retval); }
kretprobe:snd_soc_mt8901_afe:mt8901_afe_sram_start_pcm /comm=="aplay" || comm=="arecord"/ { printf("AFE_START_RETURN=%d\n",(int64)retval); }
interval:s:30 { exit(); }
