+/*
+ * Throttle thermal policy: 0 - default, 1 - overboost, 2 - silent
+ */
+static DEVICE_ATTR_RW(throttle_thermal_policy);
+#endif /* IS_ENABLED(CONFIG_ASUS_WMI_DEPRECATED_ATTRS) */
