-static ssize_t pwm1_enable_store(struct device *dev,
-						  struct device_attribute *attr,
-						  const char *buf, size_t count)
-{
-	struct asus_wmi *asus = dev_get_drvdata(dev);
-	int status = 0;
-	int state;
-	int value;
-	int ret;
-	u32 retval;
-
-	ret = kstrtouint(buf, 10, &state);
-	if (ret)
