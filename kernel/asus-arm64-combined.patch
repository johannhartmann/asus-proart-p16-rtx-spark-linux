-
-	if (asus->fan_type == FAN_TYPE_SPEC83) {
-		switch (state) { /* standard documented hwmon values */
-		case ASUS_FAN_CTRL_FULLSPEED:
-			value = 1;
-			break;
-		case ASUS_FAN_CTRL_AUTO:
-			value = 0;
-			break;
-		default:
-			return -EINVAL;
-		}
-
-		ret = asus_wmi_set_devstate(ASUS_WMI_DEVID_CPU_FAN_CTRL,
-					    value, &retval);
-		if (ret)
-			return ret;
