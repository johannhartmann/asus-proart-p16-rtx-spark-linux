-static int armoury_attr_enum_list(char *buf, size_t enum_values)
-{
-	size_t i;
-	int len = 0;
-
-	for (i = 0; i < enum_values; i++) {
-		if (i == 0)
-			len += sysfs_emit_at(buf, len, "%zu", i);
-		else
-			len += sysfs_emit_at(buf, len, ";%zu", i);
-	}
-	len += sysfs_emit_at(buf, len, "\n");
-
-	return len;
-}
