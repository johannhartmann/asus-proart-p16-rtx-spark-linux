-/* Fn-lock ********************************************************************/
-
-static bool asus_wmi_has_fnlock_key(struct asus_wmi *asus)
-{
-	u32 result;
-
-	asus_wmi_get_devstate(asus, ASUS_WMI_DEVID_FNLOCK, &result);
-
-	return (result & ASUS_WMI_DSTS_PRESENCE_BIT) &&
-		!(result & ASUS_WMI_FNLOCK_BIOS_DISABLED);
-}
