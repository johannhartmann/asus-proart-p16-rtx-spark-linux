From: Johann Hartmann <johann@mayflower.de>
Subject: [PATCH] soc: mediatek: isolate checked DSP shutdown from platform boot

Keep the established normal SSPM SET/drain policy used by platform boot
and power management. Record every unknown completion, but reject only
checked DMA-retirement commands thereafter, including across device
rebind. Ordinary transport recovery must never authorize checked DSP
memory reclamation.

Add a distinct checked SET API and route both native DSP shutdown stages
through it. The completed-stage mask prevents replay of acknowledged D3.
The normal request, acquire, D0/D3 and component-idle entry points keep
using the original transport. Hardware qualification remains required.

Link: https://github.com/NVIDIA/NV-Kernels/pull/570

diff --git a/drivers/soc/mediatek/sspm_ci/sspm_ci.c b/drivers/soc/mediatek/sspm_ci/sspm_ci.c
--- a/drivers/soc/mediatek/sspm_ci/sspm_ci.c
+++ b/drivers/soc/mediatek/sspm_ci/sspm_ci.c
@@ -131,6 +131,12 @@
  * a late interrupt could read the next command's header back from the slot.
  */
 static bool _drain_needed;
+/* A submitted timeout permanently disqualifies checked DMA-retirement
+ * transactions, even if ordinary platform clients later recover. The normal
+ * boot/power path retains its existing bounded-drain policy. Never clear this
+ * safety history on device rebind.
+ */
+static bool _completion_unknown;
 #define SSPM_CI_DRAIN_MS	100
 
 /*
@@ -213,7 +219,8 @@
 }
 
 /**
- * sspm_ci_set() - send one TINYSYS SET command to the SSPM and wait for its ack
+ * sspm_ci_set_mode() - serialize a normal or checked SSPM SET command
+ * @checked: refuse submission after any unknown SET completion in this boot
  * @feature_id: firmware feature the command addresses
  * @p1: first payload word (typically the device id)
  * @p2: second payload word (typically the composite action word)
@@ -229,9 +236,10 @@
  *   or keep its current state.
  * * -ETIMEDOUT - the command WAS written and the doorbell rung, but no ack
  *   arrived in time; the firmware may still complete it, so the outcome is
- *   unknown. A late ack is drained before the next command.
- */
-int sspm_ci_set(u32 feature_id,
+ *   unknown. A late ack is drained before the next normal command.
+ * * -ENOTRECOVERABLE - checked request after an unknown completion; nothing sent.
+ */
+static int sspm_ci_set_mode(bool checked, u32 feature_id,
 	u32 p1, u32 p2, u32 p3, u32 p4, u32 p5)
 {
 	struct scmi_msg_t scmi_tx = {};
@@ -262,6 +270,12 @@
 	if (!sspm_mbox_iomap) {
 		mutex_unlock(&_hw_rsc);
 		return -ENODEV;
+	}
+
+	/* Checked users must never mistake a delayed reply for power-off. */
+	if (checked && _completion_unknown) {
+		mutex_unlock(&_hw_rsc);
+		return -ENOTRECOVERABLE;
 	}
 
 	/*
@@ -319,6 +333,7 @@
 			 */
 			WRITE_ONCE(_inflight_hdr, 0);
 			_drain_needed = true;
+			_completion_unknown = true;
 			mutex_unlock(&_hw_rsc);
 			dev_err(__dev, "scmi ack timeout (hdr %#x), completion unknown\n",
 				message_header);
@@ -334,7 +349,19 @@
 			__func__, feature_id, p1, p2, p3, p4, p5);
 	return 0;
 }
+/* Preserve the platform's existing boot/power recovery semantics. */
+int sspm_ci_set(u32 feature_id, u32 p1, u32 p2, u32 p3, u32 p4, u32 p5)
+{
+	return sspm_ci_set_mode(false, feature_id, p1, p2, p3, p4, p5);
+}
 EXPORT_SYMBOL(sspm_ci_set);
+
+/* Only checked completions can authorize operating-DMA reclamation. */
+int sspm_ci_set_checked(u32 feature_id, u32 p1, u32 p2, u32 p3, u32 p4, u32 p5)
+{
+	return sspm_ci_set_mode(true, feature_id, p1, p2, p3, p4, p5);
+}
+EXPORT_SYMBOL_GPL(sspm_ci_set_checked);
 
 #define SCMI_MESSAGE_HEADER_CORRELATE_MASK \
 	(SCMI_MESSAGE_HEADER_MESSAGE_ID_MASK | \
diff --git a/drivers/soc/mediatek/sspm_ci/sspm_ci.h b/drivers/soc/mediatek/sspm_ci/sspm_ci.h
--- a/drivers/soc/mediatek/sspm_ci/sspm_ci.h
+++ b/drivers/soc/mediatek/sspm_ci/sspm_ci.h
@@ -15,4 +15,11 @@
  */
 int sspm_ci_set(u32 feature_id,
 	u32 p1, u32 p2, u32 p3, u32 p4, u32 p5);
+/* Checked shutdown consumer: same wire format, but any submitted timeout
+ * (including one from a normal client) permanently rejects checked commands
+ * with -ENOTRECOVERABLE until reboot. Device rebind cannot clear this history.
+ * Normal transport recovery is not evidence that DMA retirement is safe.
+ */
+int sspm_ci_set_checked(u32 feature_id,
+	u32 p1, u32 p2, u32 p3, u32 p4, u32 p5);
 #endif /* _SSPM_CI_H_ */
diff --git a/drivers/soc/mediatek/power_wrap/power_wrap.c b/drivers/soc/mediatek/power_wrap/power_wrap.c
--- a/drivers/soc/mediatek/power_wrap/power_wrap.c
+++ b/drivers/soc/mediatek/power_wrap/power_wrap.c
@@ -204,7 +204,7 @@
  */
 static int pwrap_scmi_dispatch(struct pwrap_dev_config *cfg,
 				   u8 action_idx, u32 composite,
-				   const char *action_name)
+				   const char *action_name, bool checked)
 {
 	if (cfg->control_type != CTRL_BY_SCMI) {
 		pr_warn("%s: control type 0x%x is not scmi for dev %s\n",
@@ -221,6 +221,12 @@
 		cfg->scmi_config.data[action_idx][SCMI_DATA_02],
 		cfg->scmi_config.data[action_idx][SCMI_DATA_03]);
 
+	if (checked)
+		return sspm_ci_set_checked(cfg->scmi_config.feat_id,
+				   cfg->scmi_config.dev_id, composite,
+				   cfg->scmi_config.data[action_idx][SCMI_DATA_01],
+				   cfg->scmi_config.data[action_idx][SCMI_DATA_02],
+				   cfg->scmi_config.data[action_idx][SCMI_DATA_03]);
 	return sspm_ci_set(cfg->scmi_config.feat_id,
 			   cfg->scmi_config.dev_id,
 			   composite,
@@ -237,7 +243,7 @@
 		return -ENODEV;
 	return pwrap_scmi_dispatch(cfg, SCMI_DEV_REQUEST,
 				   cfg->scmi_config.data[SCMI_DEV_REQUEST][SCMI_DATA_00],
-				   __func__);
+				   __func__, false);
 }
 EXPORT_SYMBOL_GPL(mtk_pwrap_dev_request);
 
@@ -343,9 +349,43 @@
 		return -ENODEV;
 	return pwrap_scmi_dispatch(cfg, SCMI_DEV_ADANDON,
 				   cfg->scmi_config.data[SCMI_DEV_ADANDON][SCMI_DATA_00],
-				   __func__);
+				   __func__, false);
 }
 EXPORT_SYMBOL_GPL(mtk_pwrap_dev_remove);
+
+/* Idle shutdown consumer only: freeze work and drain IRQs first. Both stages
+ * use checked SSPM commands. Any earlier submitted timeout, including one
+ * from a normal platform client, blocks DMA retirement until reboot. Normal
+ * boot/power clients retain their existing transport policy.
+ * Keep runtime PM active until success, then disable it without another D3.
+ * completed belongs to this consumer and prevents replay of acknowledged D3.
+ */
+int mtk_pwrap_dev_shutdown(void *dev_cfg, u32 *completed)
+{
+	struct pwrap_dev_config *cfg = dev_cfg;
+	u32 composite;
+	int ret;
+
+	if (!cfg || !completed || (*completed != 0 && *completed != 1 && *completed != 3))
+		return -EINVAL;
+	if (!(*completed & 1)) {
+		composite = PWRAP_SCMI_DEV_ACT_PAYLOAD(
+			cfg->scmi_config.data[SCMI_DEV_STATE][SCMI_DATA_00], DEV_STA_D3, 1, 0);
+		ret = pwrap_scmi_dispatch(cfg, SCMI_DEV_STATE, composite, __func__, true);
+		if (ret)
+			return ret;
+		*completed = 1;
+	}
+	if (*completed & 2)
+		return 0;
+	ret = pwrap_scmi_dispatch(cfg, SCMI_DEV_ADANDON,
+		cfg->scmi_config.data[SCMI_DEV_ADANDON][SCMI_DATA_00], __func__, true);
+	if (!ret)
+		*completed = 3;
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mtk_pwrap_dev_shutdown);
+
 
 int mtk_pwrap_dev_suspend(void *dev_cfg, u8 sys_trans)
 {
@@ -356,7 +396,7 @@
 		return -ENODEV;
 	composite = PWRAP_SCMI_DEV_ACT_PAYLOAD(
 		cfg->scmi_config.data[SCMI_DEV_STATE][SCMI_DATA_00], DEV_STA_D3, 1, sys_trans);
-	return pwrap_scmi_dispatch(cfg, SCMI_DEV_STATE, composite, __func__);
+	return pwrap_scmi_dispatch(cfg, SCMI_DEV_STATE, composite, __func__, false);
 }
 EXPORT_SYMBOL_GPL(mtk_pwrap_dev_suspend);
 
@@ -369,7 +409,7 @@
 		return -ENODEV;
 	composite = PWRAP_SCMI_DEV_ACT_PAYLOAD(
 		cfg->scmi_config.data[SCMI_DEV_STATE][SCMI_DATA_00], DEV_STA_D0, 0, sys_trans);
-	return pwrap_scmi_dispatch(cfg, SCMI_DEV_STATE, composite, __func__);
+	return pwrap_scmi_dispatch(cfg, SCMI_DEV_STATE, composite, __func__, false);
 }
 EXPORT_SYMBOL_GPL(mtk_pwrap_dev_resume);
 
@@ -382,7 +422,7 @@
 		return -ENODEV;
 	composite = PWRAP_SCMI_DEV_ACT_PAYLOAD(
 		cfg->scmi_config.data[SCMI_COM_IDLE][SCMI_DATA_00], com_idx, COM_STA_L1, 1);
-	return pwrap_scmi_dispatch(cfg, SCMI_COM_IDLE, composite, __func__);
+	return pwrap_scmi_dispatch(cfg, SCMI_COM_IDLE, composite, __func__, false);
 }
 EXPORT_SYMBOL_GPL(mtk_pwrap_com_idle);
 
@@ -395,7 +435,7 @@
 		return -ENODEV;
 	composite = PWRAP_SCMI_DEV_ACT_PAYLOAD(
 		cfg->scmi_config.data[SCMI_COM_IDLE][SCMI_DATA_00], com_idx, COM_STA_L0, 0);
-	return pwrap_scmi_dispatch(cfg, SCMI_COM_IDLE, composite, __func__);
+	return pwrap_scmi_dispatch(cfg, SCMI_COM_IDLE, composite, __func__, false);
 }
 EXPORT_SYMBOL_GPL(mtk_pwrap_com_active);
 
diff --git a/include/linux/soc/mediatek/mtk-pwrap.h b/include/linux/soc/mediatek/mtk-pwrap.h
--- a/include/linux/soc/mediatek/mtk-pwrap.h
+++ b/include/linux/soc/mediatek/mtk-pwrap.h
@@ -71,6 +71,7 @@
 int mtk_send_power_control_req(struct _power_cntrl_request *pwrctlreq);
 int mtk_pwrap_dev_request(void *dev_ctrl);
 int mtk_pwrap_dev_remove(void *dev_ctrl);
+int mtk_pwrap_dev_shutdown(void *dev_ctrl, u32 *completed);
 int mtk_pwrap_dev_suspend(void *dev_ctrl, u8 sys_trans);
 int mtk_pwrap_dev_resume(void *dev_ctrl, u8 sys_trans);
 int mtk_pwrap_com_idle(void *dev_ctrl, u8 com_idx);
@@ -92,6 +93,11 @@
 static inline int mtk_pwrap_dev_remove(void *dev_ctrl)
 {
 	return -ENODEV;
+}
+
+static inline int mtk_pwrap_dev_shutdown(void *dev_ctrl, u32 *completed)
+{
+	return -EOPNOTSUPP;
 }
 
 static inline int mtk_pwrap_dev_suspend(void *dev_ctrl, u8 sys_trans)
diff --git a/drivers/soc/mediatek/power_wrap/inc/pwrap_scmi.h b/drivers/soc/mediatek/power_wrap/inc/pwrap_scmi.h
--- a/drivers/soc/mediatek/power_wrap/inc/pwrap_scmi.h
+++ b/drivers/soc/mediatek/power_wrap/inc/pwrap_scmi.h
@@ -11,11 +11,18 @@
 #ifdef CONFIG_MTK_SSPM_CI
 int sspm_ci_set(u32 feature_id,
 	u32 p1, u32 p2, u32 p3, u32 p4, u32 p5);
+int sspm_ci_set_checked(u32 feature_id,
+	u32 p1, u32 p2, u32 p3, u32 p4, u32 p5);
 #else
 static inline int sspm_ci_set(u32 feature_id,
 	u32 p1, u32 p2, u32 p3, u32 p4, u32 p5)
 {
 	return -ENODEV;
+}
+static inline int sspm_ci_set_checked(u32 feature_id,
+	u32 p1, u32 p2, u32 p3, u32 p4, u32 p5)
+{
+	return -EOPNOTSUPP;
 }
 #endif /* CONFIG_MTK_SSPM_CI */
 
