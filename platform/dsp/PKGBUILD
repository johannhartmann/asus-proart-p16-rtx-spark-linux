check() {
  cd "$srcdir"
  python test_device_lookup.py
  python test_card_client.py
  python test_provider.py
  python test_driver.py
  python test_pm.py
  python test_shutdown.py
  python test_transport.py
  python test_primary.py
  python test_lifecycle.py
  python test_pcm_service.py
  python test_period.py
  python test_producer.py
  python test_trigger.py
  cc -std=gnu11 -Wall -Wextra -Werror -fsanitize=address,undefined -g \
    ipc_test.c -o ipc-test
  ./ipc-test
  cc -std=gnu11 -Wall -Wextra -Werror -fsanitize=address,undefined -g \
    pcm_test.c -o pcm-test
  ./pcm-test
}

package() {
  install -Dm644 "$srcdir/n1x-adsp-audio.service" "$pkgdir/usr/lib/systemd/system/n1x-adsp-audio.service"
  install -Dm755 "$srcdir/n1x-adsp-audio" "$pkgdir/usr/libexec/n1x-adsp-audio"
  local file
  for file in n1x_adsp.c n1x_sroot_client.h n1x_sroot_firmware.h n1x_adsp_ipc.h n1x_adsp_client.h n1x_adsp_pcm.h mt8901-afe-sram.h Kbuild dkms.conf provenance.json; do
    install -Dm644 "$srcdir/$file" "$pkgdir/usr/src/n1x-adsp-$pkgver/$file"
  done
  install -Dm644 "$srcdir/n1x-adsp.conf" "$pkgdir/usr/lib/modprobe.d/n1x-adsp.conf"
  install -Dm644 "$srcdir/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 "$srcdir/protocol.md" "$pkgdir/usr/share/doc/$pkgname/protocol.md"
}
