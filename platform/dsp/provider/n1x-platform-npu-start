#!/usr/bin/bash
# Firmware, ACPI resource and DMA-coherency validation belongs to the C driver.
set -euo pipefail
export PATH=/usr/bin:/bin
fail() { echo "n1x-npu: $*" >&2; exit 1; }
find_endpoint() {
    local hid=$1 path found=
    for path in /sys/bus/platform/devices/*; do
        [[ -r $path/firmware_node/hid ]] || continue
        [[ $(<"$path/firmware_node/hid") == "$hid" ]] || continue
        [[ -z $found ]] || fail "Multiple platform devices for $hid"
        found=$path
    done
    [[ -n $found ]] || fail "Platform device missing: $hid"
    printf '%s\n' "$found"
}
dla=$(find_endpoint NVDA200A)
sroot=$(find_endpoint NVDA8600)
verify() {
    [[ $(basename "$(readlink -e "$dla/driver")") == n1x-npu-bootstrap ]] || fail 'Wrong NPU driver'
    local status=/sys/kernel/debug/n1x-npu-bootstrap/status
    local hfrp=/sys/kernel/debug/n1x-npu-bootstrap/hfrp_status key
    for key in dla_bound sroot_bound idle_observed ping_verified region5_registered config_valid config_apply_accepted lpwr_accepted task_verified; do
        grep -Eq "(^|[[:space:]])$key=1([[:space:]]|$)" "$status" || fail "Startup incomplete: $key"
    done
    for key in error queue_poisoned; do
        grep -Eq "(^|[[:space:]])$key=0([[:space:]]|$)" "$status" || fail "Startup failed: $key"
    done
    grep -Eq '(^|[[:space:]])power_accepted=1([[:space:]]|$)' "$hfrp" || fail 'NPU power handshake failed'
    grep -Eq '(^|[[:space:]])error=0([[:space:]]|$)' "$hfrp" || fail 'HFRP error'
    grep -q ' n1x_sroot_client_ops_v4[[:space:]]*\[n1x_npu_bootstrap\]' /proc/kallsyms || fail 'SROOT export missing'
    local node found=false
    for node in /sys/class/accel/accel*; do
        if [[ $(readlink -e "$node/device") == "$(readlink -e "$dla")" &&
              -c /dev/accel/${node##*/} ]]; then found=true; fi
    done
    $found || fail 'Accelerator device missing'
}
stop() {
    [[ -d /sys/module/n1x_npu_bootstrap ]] || return 0
    local device=$dla
    local status=/sys/kernel/debug/n1x-npu-bootstrap/shutdown_status key
    # The kernel serializes this with submissions and DSP publication. It
    # refuses failed channels and published DSP buffers without releasing DMA.
    [[ -w $device/shutdown ]] || fail 'Checked shutdown interface missing; module retained'
    printf 'stop\n' > "$device/shutdown" || fail 'Checked shutdown refused; module retained'
    for key in hardware_off released; do
        grep -Eq "(^|[[:space:]])$key=1([[:space:]]|$)" "$status" || fail "Shutdown incomplete: $key; module retained"
    done
    for key in error hfrp_held upload_held; do
        grep -Eq "(^|[[:space:]])$key=0([[:space:]]|$)" "$status" || fail "Shutdown failed: $key; module retained"
    done
    modprobe -r n1x_npu_bootstrap
}
case ${1:-} in
    --check-host) exit 0 ;;
    --verify) verify; exit 0 ;;
    --stop) stop; exit 0 ;;
    --prepare) ;;
    *) fail 'Usage: n1x-platform-npu-start --check-host|--prepare|--verify|--stop' ;;
esac
bound=0
for device in "$dla" "$sroot"; do
    if [[ -e $device/driver ]]; then bound=$((bound + 1)); fi
done
if ((bound == 2)); then verify; exit 0; fi
((bound == 0)) || fail 'Partially bound NPU; refusing domain changes'
controls=()
# Validate both isolated groups before changing either domain.
for device in "$dla" "$sroot"; do
    name=${device##*/}
    [[ -d $device/iommu ]] || fail 'IOMMU supplier missing'
    group=$(readlink -e "$device/iommu_group")
    [[ ${group%/*} == /sys/kernel/iommu_groups ]] || fail 'Invalid IOMMU group'
    members=("$group"/devices/*)
    [[ ${#members[@]} == 1 && ${members[0]##*/} == "$name" ]] || fail 'Unexpected shared IOMMU group'
    case $(<"$group/type") in identity|DMA|DMA-FQ) ;; *) fail 'Unsupported IOMMU domain type' ;; esac
    controls+=("$group/type")
done
for control in "${controls[@]}"; do
    if [[ $(<"$control") == identity ]]; then printf 'DMA\n' > "$control"; fi
    case $(<"$control") in DMA|DMA-FQ) ;; *) fail 'DMA domain selection failed' ;; esac
done
