#!/usr/bin/env bash
set -euo pipefail

driver_dir=${P16_VAAPI_DRIVER_DIR:-${HOME}/.local/lib/p16-vaapi-h264}
profile=${P16_MEET_CHROME_PROFILE:-${XDG_DATA_HOME:-${HOME}/.local/share}/p16-meet-chrome}
support_dir=${P16_MEET_SUPPORT_DIR:-${XDG_DATA_HOME:-${HOME}/.local/share}/p16-meet-support}
[[ -x /usr/bin/google-chrome-stable ]] || { echo 'Google Chrome is required' >&2; exit 127; }
command -v node >/dev/null || { echo 'Node.js is required' >&2; exit 127; }
[[ -r $driver_dir/nvidia_vulkan_drv_video.so ]] || {
  echo "Missing N1X VA-API driver: $driver_dir/nvidia_vulkan_drv_video.so" >&2
  echo 'Run platform/video/vaapi-h264/build-install-user first' >&2
  exit 2
}
[[ -r $support_dir/run-meet-chrome.mjs && -r $support_dir/meet-h264-codec/manifest.json ]] || {
  echo 'Missing Meet codec gate: run platform/video/vaapi-h264/install-launcher-user' >&2
  exit 2
}
mkdir -p "$profile"
exec node "$support_dir/run-meet-chrome.mjs" \
  "--profile=$profile" "--driver-dir=$driver_dir" "$@"
