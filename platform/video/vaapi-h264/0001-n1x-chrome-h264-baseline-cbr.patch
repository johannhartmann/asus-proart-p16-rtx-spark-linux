+VAStatus vkvvDeriveImage(VADriverContextP ctx, VASurfaceID surface_id, VAImage* image) {
+    VkvvDriver* drv = vkvv_driver_from_ctx(ctx);
+    if (drv == nullptr || image == nullptr) {
+        return VA_STATUS_ERROR_INVALID_PARAMETER;
+    }
+    auto* surface = vkvv_surface_get_locked(drv, surface_id);
+    if (surface == nullptr) {
+        return VA_STATUS_ERROR_INVALID_SURFACE;
+    }
+    LockedSurface lock(surface);
+    if (surface->destroying || surface->decoded || surface->work_state == VKVV_SURFACE_WORK_RENDERING) {
+        return VA_STATUS_ERROR_OPERATION_FAILED;
+    }
+    VAImageFormat format{};
+    format.fourcc = surface->fourcc;
+    VAStatus status = vkvvCreateImage(ctx, &format, surface->width, surface->height, image);
+    if (status != VA_STATUS_SUCCESS) {
+        return status;
+    }
+    auto* buffer = static_cast<VkvvBuffer*>(vkvv_object_get(drv, image->buf, VKVV_OBJECT_BUFFER));
+    if (buffer == nullptr) {
+        (void)vkvvDestroyImage(ctx, image->image_id);
+        return VA_STATUS_ERROR_INVALID_BUFFER;
+    }
+    buffer->derived_image = image->image_id;
+    buffer->derived_surface = surface_id;
+    buffer->flush_on_unmap = vkvvFlushDerivedImage;
+    return VA_STATUS_SUCCESS;
+}
+
+VAStatus vkvvFlushDerivedImage(VADriverContextP ctx, VABufferID buffer_id) {
+    VkvvDriver* drv = vkvv_driver_from_ctx(ctx);
+    auto* buffer = static_cast<VkvvBuffer*>(vkvv_object_get(drv, buffer_id, VKVV_OBJECT_BUFFER));
+    if (buffer == nullptr || buffer->derived_image == VA_INVALID_ID || buffer->derived_surface == VA_INVALID_ID) {
+        return VA_STATUS_SUCCESS;
+    }
+    auto* image = static_cast<VkvvImage*>(vkvv_object_get(drv, buffer->derived_image, VKVV_OBJECT_IMAGE));
+    if (image == nullptr) {
+        return VA_STATUS_ERROR_INVALID_IMAGE;
+    }
+    return vkvvPutImage(ctx, buffer->derived_surface, buffer->derived_image, 0, 0, image->image.width, image->image.height,
+                        0, 0, image->image.width, image->image.height);
+}
+
