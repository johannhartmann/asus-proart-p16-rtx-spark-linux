#!/usr/bin/env bash
set -euo pipefail
if (( $# < 2 || $# > 3 )); then
  echo 'Usage: p16-interpolate-video INPUT_VIDEO OUTPUT.mkv [MAX_FRAME_PAIRS]' >&2
  exit 2
fi
input=$1
output=$2
pairs=${3:-1000000}
if [[ ! -f $input ]]; then
  echo "Video file not found: $input" >&2
  exit 2
fi
if [[ -e $output ]]; then
  echo "Output already exists: $output" >&2
  exit 2
fi
if [[ ! $pairs =~ ^[0-9]+$ ]] || (( pairs < 1 || pairs > 1000000 )); then
  echo 'MAX_FRAME_PAIRS must be an integer from 1 to 1000000' >&2
  exit 2
fi
details=$(/usr/bin/ffprobe -v error -select_streams v:0 \
  -show_entries stream=width,height,avg_frame_rate -of csv=p=0 "$input")
IFS=, read -r width height rate <<< "$details"
if [[ ! $width =~ ^[0-9]+$ || ! $height =~ ^[0-9]+$ ]] || \
   (( width < 128 || height < 64 || width > 4096 || height > 4096 ||
      width % 4 != 0 || height % 4 != 0 )); then
  echo "NVOFA export needs source dimensions divisible by four, from 128x64 to 4096x4096: ${width}x${height}" >&2
  exit 2
fi
if [[ ! $rate =~ ^[0-9]+/[0-9]+$ ]]; then
  echo "Video has no usable constant frame rate: $rate" >&2
  exit 2
fi
numerator=${rate%/*}
denominator=${rate#*/}
if (( numerator < 1 || denominator < 1 )); then
  echo "Video has no usable frame rate: $rate" >&2
  exit 2
fi
# This export represents every adjacent source pair with one intermediate frame.
output_rate="$((2 * numerator))/$denominator"
temporary=$(mktemp "${output}.partial.XXXXXX")
trap 'rm -f -- "$temporary"' EXIT
analyzer=${P16_NVOF_BINARY:-/usr/bin/p16-nvof-analyze}
/usr/bin/ffmpeg -hide_banner -loglevel error -nostdin -i "$input" -an \
  -vf format=rgb24 \
  -frames:v "$((pairs + 1))" -fps_mode passthrough -f rawvideo - | \
  "$analyzer" --interpolate "$width" "$height" "$pairs" | \
  /usr/bin/ffmpeg -hide_banner -loglevel info -nostdin \
    -init_hw_device vulkan=vk:0 -filter_hw_device vk \
    -f rawvideo -pixel_format rgb24 -video_size "${width}x${height}" \
    -framerate "$output_rate" -i pipe:0 -i "$input" \
    -map 0:v:0 -map 1:a? -vf format=nv12,hwupload \
    -c:v h264_vulkan -c:a copy -shortest -f matroska -y "$temporary"
ln -- "$temporary" "$output"
