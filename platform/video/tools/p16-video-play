#!/usr/bin/env bash
set -euo pipefail

if (( $# < 1 )); then
  echo 'Usage: p16-video-play VIDEO_OR_URL [mpv options...]' >&2
  exit 2
fi

export LIBVA_DRIVER_NAME=nvidia
export NVD_BACKEND=direct
exec /usr/bin/mpv --hwdec=vaapi --vo=gpu-next --gpu-api=vulkan \
  --scale=ewa_lanczos --interpolation --tscale=oversample \
  --video-sync=display-resample "$@"
