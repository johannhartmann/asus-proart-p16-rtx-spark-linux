#!/usr/bin/env bash
set -euo pipefail

fixed_fps=false
if (( $# == 3 )) && [[ $1 == --fixed-fps ]]; then
  fixed_fps=true
  shift
fi
if (( $# != 2 )); then
  echo 'Usage: p16-record-camera-vulkan [--fixed-fps] SECONDS OUTPUT.mkv' >&2
  exit 2
fi

duration=$1
output=$2
if [[ ! $duration =~ ^[0-9]+$ ]] || (( duration < 1 || duration > 3600 )); then
  echo 'SECONDS must be an integer from 1 to 3600' >&2
  exit 2
fi
if [[ -e $output ]]; then
  echo "Output already exists: $output" >&2
  exit 2
fi

device=${P16_RGB_DEVICE:-/dev/v4l/by-path/platform-NVDA8001:00-usb-0:1:1.0-video-index0}
if [[ ! -e $device ]]; then
  echo "P16 RGB camera not available: $device" >&2
  exit 1
fi

command=(/usr/bin/ffmpeg -hide_banner
  -init_hw_device vulkan=vk:0 -filter_hw_device vk
  -f v4l2 -input_format mjpeg -video_size 1280x720 -framerate 30
  -i "$device" -t "$duration"
  -vf format=nv12,hwupload -c:v h264_vulkan -an
  -f matroska -n "$output")

if ! $fixed_fps; then
  exec "${command[@]}"
fi

control=exposure_dynamic_framerate
readback=$(/usr/bin/v4l2-ctl -d "$device" -C "$control")
if [[ ! $readback =~ ^exposure_dynamic_framerate:[[:space:]]*([01])$ ]]; then
  echo "Unexpected camera control response: $readback" >&2
  exit 1
fi
original=${BASH_REMATCH[1]}
restore_control() {
  /usr/bin/v4l2-ctl -d "$device" -c "$control=$original" >&2 ||
    echo 'Could not restore camera exposure frame-rate control' >&2
}
trap restore_control EXIT
/usr/bin/v4l2-ctl -d "$device" -c "$control=0" >&2
set +e
"${command[@]}"
status=$?
set -e
/usr/bin/v4l2-ctl -d "$device" -c "$control=$original" >&2
trap - EXIT
exit "$status"
