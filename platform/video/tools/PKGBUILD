pkgname=p16-media-tools
pkgver=0.1.0
pkgrel=3
pkgdesc='P16 NVIDIA video playback, HDR output and Vulkan camera recording commands'
arch=('aarch64')
url='https://github.com/johannhartmann/asus-proart-p16-rtx-spark-linux'
license=('MIT')
depends=('ffmpeg' 'mpv' 'hyprland' 'python' 'gstreamer' 'gst-plugins-base-libs'
         'gst-plugins-bad-libs' 'libva-nvidia-driver' 'nvidia-utils')
source=('p16-video-play' 'p16-hdr-play' 'p16-record-camera-vulkan'
        'p16-record-camera-gstreamer' 'README.md' 'LICENSE')
sha256sums=('fbc1e8c5715e4491e4bd7cc5d2761f595c02f1170326bcafbd0b02f1e8694688'
            '291aea39c5ed3cadba150bfe09a2f42f60290e6f959518611f312e8aa942d92e'
            'b5b4cc38fd32929719c645aa88b1974a6f0abd062888df1c5df6ad45ca21a6f4'
            '701188cca4dfbc4d0cbf9fd431a44b90901bca830e05c5c7784be4e1005a36b8'
            'bfd0033ecb5ae59e7e23d21f2f6272cc6d7d076ac9c05f7cf1ae1c042e0b7a46'
            '213e4f92de2bfb95c95fc90aa94a5378e92a7c3bdf1d2b22768da3fa9068b3b3')

check() {
  bash -n "$srcdir/p16-video-play" "$srcdir/p16-record-camera-vulkan" \
    "$srcdir/p16-record-camera-gstreamer"
  python -m py_compile "$srcdir/p16-hdr-play"
}

package() {
  install -Dm755 "$srcdir/p16-video-play" "$pkgdir/usr/bin/p16-video-play"
  install -Dm755 "$srcdir/p16-hdr-play" "$pkgdir/usr/bin/p16-hdr-play"
  install -Dm755 "$srcdir/p16-record-camera-vulkan" \
    "$pkgdir/usr/bin/p16-record-camera-vulkan"
  install -Dm755 "$srcdir/p16-record-camera-gstreamer" \
    "$pkgdir/usr/bin/p16-record-camera-gstreamer"
  install -Dm644 "$srcdir/README.md" \
    "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 "$srcdir/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
