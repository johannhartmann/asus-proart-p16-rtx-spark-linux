pkgname=ffmpeg-n1x-video
pkgver=9.0.2
pkgrel=3
pkgdesc='Isolated ARM64 FFmpeg candidate with NVIDIA NVENC and NVDEC support'
arch=('aarch64')
url='https://ffmpeg.org/'
license=('GPL-2.0-or-later')
depends=('glibc' 'gcc-libs' 'nvidia-utils' 'x264' 'x265' 'libvpx')
makedepends=('gcc' 'make' 'pkgconf' 'clang')
_nvcodec_ver=13.1.15.0
source=("https://ffmpeg.org/releases/ffmpeg-${pkgver}.tar.xz"
        "https://github.com/FFmpeg/nv-codec-headers/archive/refs/tags/n${_nvcodec_ver}.tar.gz"
        'README.md')
sha256sums=('8c3850283eb25fa026482078a04051e0be17347b09ef81a0849bec15a96e002e'
            '2255bc74d038b95aa4be30f5f66322c2176acbdb90ada1851db6993536fbeaf7'
            '6fe1a432aa7de27ab106cd9b7dfc4865c677295d1aede9b594a78c2edd821e24')

build() {
  make -C "$srcdir/nv-codec-headers-n$_nvcodec_ver" \
    PREFIX="$srcdir/_nvcodec" install

  cd "$srcdir/ffmpeg-$pkgver"
  PKG_CONFIG_PATH="$srcdir/_nvcodec/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}" \
    ./configure \
      --prefix=/usr \
      --progs-suffix=-n1x \
      --disable-shared \
      --enable-static \
      --enable-gpl \
      --enable-libx264 \
      --enable-libx265 \
      --enable-libvpx \
      --enable-nvenc \
      --enable-nvdec \
      --enable-cuvid \
      --enable-cuda-llvm \
      --disable-doc \
      --disable-ffplay
  make
}

check() {
  "$srcdir/ffmpeg-$pkgver/ffmpeg-n1x" -hide_banner -encoders > "$srcdir/encoders.txt"
  "$srcdir/ffmpeg-$pkgver/ffmpeg-n1x" -hide_banner -decoders > "$srcdir/decoders.txt"
  grep -q h264_nvenc "$srcdir/encoders.txt"
  grep -q hevc_nvenc "$srcdir/encoders.txt"
  grep -q av1_nvenc "$srcdir/encoders.txt"
  grep -q h264_cuvid "$srcdir/decoders.txt"
  "$srcdir/ffmpeg-$pkgver/ffprobe-n1x" -version >/dev/null
}

package() {
  install -Dm755 "$srcdir/ffmpeg-$pkgver/ffmpeg-n1x" \
    "$pkgdir/usr/bin/ffmpeg-n1x"
  install -Dm755 "$srcdir/ffmpeg-$pkgver/ffprobe-n1x" \
    "$pkgdir/usr/bin/ffprobe-n1x"
  install -Dm644 "$srcdir/ffmpeg-$pkgver/COPYING.GPLv2" \
    "$pkgdir/usr/share/licenses/$pkgname/COPYING.GPLv2"
  install -Dm644 "$srcdir/README.md" \
    "$pkgdir/usr/share/doc/$pkgname/README.md"
}
