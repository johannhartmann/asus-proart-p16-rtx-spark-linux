 /*
- * PM notifier for automatic suspend/resume functionality
+ * Keep the suspend gates owned by one non-freezable task until resume. The
+ * blocking PM notifier rwsem must not be reacquired by a task still holding
+ * those gates: PREPARE and POST are separate calls into that notifier chain.
+ * PM callbacks are serialized by the kernel's system_transition_mutex.
  */
+static struct {
+    struct completion prepared;
+    struct task_struct *task;
+    nv_power_state_t power_state;
+    NV_STATUS status;
+} nv_pm_context;
+
+static int nv_pm_thread(void *unused)
+{
+    NV_STATUS status;
+
+    status = nv_set_system_power_state(nv_pm_context.power_state,
+                                       nv_procfs_pm_action_depth);
+    nv_pm_context.status = status;
+    complete(&nv_pm_context.prepared);
+
+    /* Even a failed PREPARE waits for kthread_stop(), keeping task valid. */
+    for (;;)
+    {
+        set_current_state(TASK_INTERRUPTIBLE);
+        if (kthread_should_stop())
+            break;
+        schedule();
+    }
+    __set_current_state(TASK_RUNNING);
+
+    if (status == NV_OK)
+        status = nv_set_system_power_state(NV_POWER_STATE_RUNNING,
+                                           nv_procfs_pm_action_depth);
+    return status;
+}
