license=('MIT')
depends=('dkms' 'nvidia-open-dkms=620.70.06')
conflicts=('n1x-nvidia-drm-fix')
backup=('etc/dkms/nvidia-620.70.06.conf')
source=('nvidia-620.70.06.conf'
        'nvidia-drm-colorspace-deadlock.patch'
        'nvidia-pm-notifier-owner.patch'
        'nvidia-uvm-pm-lock-order.patch'
        'nvidia-drm-content-protection-flip-deadlock.patch'
        'LICENSE')
sha256sums=('ec4caf1aaccbc0bdb6e64ea71a99a89a3951ca025961a11b4330200c5a3d5e0a'
            '25c4ac9d1bfbb4047a4fddc400bf18de16aebfb68dcbc8fb2cc63557435d9308'
            '97f56fa1500c9926cfb815d73476ede5b81ec653837da716c7259a1ec748800d'
            'd7f38f390c1ee867d83638e6919eb22218efb5163efb6eb71dc0c1b727646cda'
            'a144c2798d9db6cc8c0493133e2ed045ba6c630bca090e65f1c34d2233376a69'
            'be8abef689a81e0c5d51d89c9061c266e285cae2d7e9a61abe71be8a1c74e763')

package() {
  install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$srcdir/nvidia-620.70.06.conf" "$pkgdir/etc/dkms/nvidia-620.70.06.conf"
  install -Dm644 "$srcdir/nvidia-drm-colorspace-deadlock.patch" \
    "$pkgdir/etc/dkms/nvidia/patches/nvidia-drm-colorspace-deadlock.patch"
  install -Dm644 "$srcdir/nvidia-pm-notifier-owner.patch" \
    "$pkgdir/etc/dkms/nvidia/patches/nvidia-pm-notifier-owner.patch"
  install -Dm644 "$srcdir/nvidia-uvm-pm-lock-order.patch" \
    "$pkgdir/etc/dkms/nvidia/patches/nvidia-uvm-pm-lock-order.patch"
  install -Dm644 "$srcdir/nvidia-drm-content-protection-flip-deadlock.patch" \
    "$pkgdir/etc/dkms/nvidia/patches/nvidia-drm-content-protection-flip-deadlock.patch"
}
