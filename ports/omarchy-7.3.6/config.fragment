# Keep the P16 driver and validation options on Omarchy's ARM64 configuration.
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_ACPI_WMI=m
CONFIG_ASUS_WMI=m
CONFIG_ASUS_NB_WMI=m
# CONFIG_ASUS_WMI_DEPRECATED_ATTRS is not set
# CONFIG_ASUS_ARMOURY is not set
CONFIG_SPI_HID_ACPI=m
CONFIG_DEBUG_KERNEL=y
CONFIG_PROVE_LOCKING=y
CONFIG_DEBUG_SPINLOCK=y
CONFIG_DEBUG_MUTEXES=y
CONFIG_DMA_API_DEBUG=y
# CONFIG_LOCKDEP_SMALL is not set
CONFIG_LOCKDEP_BITS=18
CONFIG_LOCKDEP_CHAINS_BITS=19
CONFIG_LOCKDEP_STACK_TRACE_BITS=23
CONFIG_LOCKDEP_STACK_TRACE_HASH_BITS=18
CONFIG_LOCKDEP_CIRCULAR_QUEUE_BITS=14
