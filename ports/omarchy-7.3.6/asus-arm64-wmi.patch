@@ -369,6 +370,14 @@ static acpi_status asus_wmi_evaluate_method_locked(u32 method_id,
 	return wmi_evaluate_method(ASUS_WMI_MGMT_GUID, 0, method_id, input, output);
 }
 
+/* H7607BA.300 returns an extended RSOC capability buffer, not an integer. */
+static bool asus_wmi_p16_extended_rsoc(void)
+{
+	return dmi_match(DMI_SYS_VENDOR, "ASUS") &&
+	       dmi_match(DMI_PRODUCT_NAME, "ProArt P16 H7607BA") &&
+	       dmi_match(DMI_BIOS_VERSION, "H7607BA.300");
+}
+
 static int asus_wmi_evaluate_method3(u32 method_id,
 		u32 arg0, u32 arg1, u32 arg2, u32 *retval)
 {
@@ -396,6 +405,12 @@ static int asus_wmi_evaluate_method3(u32 method_id,
 	obj = (union acpi_object *)output.pointer;
 	if (obj && obj->type == ACPI_TYPE_INTEGER)
 		tmp = (u32) obj->integer.value;
+	else if (obj && obj->type == ACPI_TYPE_BUFFER &&
+		 obj->buffer.length == 8 &&
+		 method_id == ASUS_WMI_METHODID_DSTS &&
+		 arg0 == ASUS_WMI_DEVID_RSOC &&
+		 asus_wmi_p16_extended_rsoc())
+		tmp = get_unaligned_le32(obj->buffer.pointer);
 
 	pr_debug("Result: 0x%08x\n", tmp);
 	if (retval)
@@ -1648,6 +1663,14 @@ static int asus_wmi_battery_add(struct power_supply *battery, struct acpi_batter
 	    &dev_attr_charge_control_end_threshold))
 		return -ENODEV;
 
+	/* Preserve firmware policy until the user explicitly writes a limit.
+	 * The cached sysfs value must not claim an unobserved threshold.
+	 */
+	if (asus_wmi_p16_extended_rsoc()) {
+		charge_end_threshold = -1;
+		return 0;
+	}
+
 	/* The charge threshold is only reset when the system is power cycled,
 	 * and we can't read the current threshold, however the majority of
 	 * platforms retains it.
